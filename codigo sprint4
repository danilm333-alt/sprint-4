SELECT t.*
FROM `sprint3_silver.transactions_clean` t
JOIN `sprint3_silver.companies_clean`c ON t.business_id=c.company_id
WHERE c.country="Germany" and 
DATE(t.timestamp) > '2022-03-11' AND DATE(t.timestamp) < '2022-03-13';

