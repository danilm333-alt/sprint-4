WITH VIP_Stats AS(
  SELECT business_id, SUM(amount) AS despesa_total,
  COUNT(transaction_id) AS numero_ingressos,
  AVG(amount) AS tiquet_mitja,
  MAX(amount)AS maxima_compra
  FROM`sprint3-analytics-daniel-lopez.sprint3_gold.fact_transactions_optimized`
  WHERE declined=1
  GROUP BY business_id
  HAVING despesa_total>500)
  SELECT* FROM VIP_Stats
  ORDER BY despesa_total DESC;



