CREATE OR REPLACE TABLE sprint3_silver.transactions_recent AS
 SELECT*EXCEPT (timestamp),
 TIMESTAMP_SUB(
  CURRENT_TIMESTAMP(),
  INTERVAL CAST(RAND()*50 AS INT64)DAY
 )as timestamp
FROM `sprint3-analytics-daniel-lopez.sprint3_silver.transactions_clean`;
-- pas2
CREATE OR REPLACE TABLE sprint3_gold.fact_transactions_optimized 
PARTITION BY DATE(timestamp)
CLUSTER BY business_id AS
SELECT *,
DATE(timestamp) as day,
TIME(timestamp) as time
FROM`sprint3_silver.transactions_recent`;
-- ex3
-- pas 1
SELECT *
FROM sprint3_silver.transactions_recent AS t
WHERE timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY);
-- pas2
SELECT *
FROM `sprint3_gold.fact_transactions_optimized`AS t
WHERE timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 30 DAY);
-- ex4 
CREATE MATERIALIZED VIEW `sprint3_gold.mv_daily_sales` AS
SELECT t.day, SUM(t.amount) AS dinero_por_dia,
  COUNT(t.transaction_id) AS num_transacciones_por_dia
FROM `sprint3_gold.fact_transactions_optimized` AS t
WHERE t.declined = 0
GROUP BY t.day;
